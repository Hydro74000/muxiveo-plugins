// Restauration (R2) : luma du flux = R'G'B' moyen (arrondi au stockage), réduite par moyenne d'aire
// (F.interpolate(mode="area") = moyenne adaptative : cellule [floor(i·n/m), ceil((i+1)·n/m))) puis bornée à [0, 1].
#version 450
#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif
layout (binding = 0) readonly buffer src_blob { sfp src_data[]; };
layout (binding = 1) writeonly buffer dst_blob { sfp dst_data[]; };
layout (push_constant) uniform parameter { int w; int h; int cstep; int outw; int outh; } p;

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    if (gx >= p.outw || gy >= p.outh || int(gl_GlobalInvocationID.z) >= 1)
        return;
    int x0 = (gx * p.w) / p.outw, x1 = ((gx + 1) * p.w + p.outw - 1) / p.outw;
    int y0 = (gy * p.h) / p.outh, y1 = ((gy + 1) * p.h + p.outh - 1) / p.outh;
    float s = 0.0;
    for (int y = y0; y < y1; y++)
        for (int x = x0; x < x1; x++)
        {
            int i = y * p.w + x;
            // moyenne des trois canaux arrondie au stockage, comme frames.mean(2) en fp16
            s += float(sfp((float(src_data[i]) + float(src_data[p.cstep + i]) + float(src_data[2 * p.cstep + i])) / 3.0));
        }
    dst_data[gy * p.outw + gx] = sfp(clamp(s / float((x1 - x0) * (y1 - y0)), 0.0, 1.0));
}
