// Restauration (R2) : tuiles du corps. mode 2 : remise à zéro de acc et wsum (tw × th = W × H) ; mode 0 : copie de
// la région [x0, x0 + tw) × [y0, y0 + th) de l'entrée (c canaux) dans la tuile tpw × tph (multiple de 4 : bords droit
// et bas répliqués, comme UNetRestore.forward) ; mode 1 : accumulation de la partie utile de la sortie de la tuile (3 canaux), pondérée par une fenêtre de
// Hann (taille n, arrondie au format de stockage puis bornée à 1e-3), dans acc (3 canaux) et wsum (flottants 32 bits).
#version 450
#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif
layout (binding = 0) readonly buffer src_blob { sfp src_data[]; };
layout (binding = 1) buffer dst_blob { sfp dst_data[]; };
layout (binding = 2) buffer acc_blob { float acc_data[]; };
layout (binding = 3) buffer wsum_blob { float wsum_data[]; };
layout (push_constant) uniform parameter
{
    int mode; int W; int H; int cstep; int c; int x0; int y0; int tw; int th; int tcstep; int wx0; int wy0; int n; int acstep; int tpw; int tph;
} p;

float hann(int i)
{
    float v = 0.5 - 0.5 * cos(6.283185307179586 * float(i) / float(p.n - 1));
    return max(float(sfp(v)), 1e-3);
}

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    if (int(gl_GlobalInvocationID.z) >= 1)
        return;
    if (p.mode == 0)
    {
        if (gx >= p.tpw || gy >= p.tph)
            return;
        int si = (p.y0 + min(gy, p.th - 1)) * p.W + (p.x0 + min(gx, p.tw - 1));
        for (int k = 0; k < p.c; k++)
            dst_data[k * p.tcstep + gy * p.tpw + gx] = src_data[k * p.cstep + si];
        return;
    }
    if (gx >= p.tw || gy >= p.th)
        return;
    int gi = (p.y0 + gy) * p.W + (p.x0 + gx);
    int ti = gy * p.tpw + gx;
    if (p.mode == 2)
    {
        for (int k = 0; k < 3; k++)
            acc_data[k * p.acstep + gi] = 0.0;
        wsum_data[gi] = 0.0;
        return;
    }
    float wgt = hann(p.wy0 + gy) * hann(p.wx0 + gx);
    for (int k = 0; k < 3; k++)
        acc_data[k * p.acstep + gi] += float(src_data[k * p.tcstep + ti]) * wgt;
    wsum_data[gi] += wgt;
}
