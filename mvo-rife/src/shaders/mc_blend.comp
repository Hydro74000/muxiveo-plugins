// Muxiveo — MC : sortie finale (RGB planaire, format du réseau).
// mode 0 : compensation seule ; mode 1 : écart de luminance |MC − RIFE| (vers diff) ;
// mode 2 : hybride  (1 − u)·((1 − m)·MC + m·RIFE) + u·RIFE,  m = 0,5·exp(−(écart/agree)²).

#version 450

#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif

layout (binding = 0) readonly buffer mc_blob { float mc_data[]; };
layout (binding = 1) readonly buffer rife_blob { sfp rife_data[]; };
layout (binding = 2) readonly buffer u_blob { float u_data[]; };
layout (binding = 3) buffer diff_blob { float diff_data[]; };
layout (binding = 4) writeonly buffer out_blob { sfp out_data[]; };

layout (push_constant) uniform parameter
{
    int w;
    int h;
    int cstep;
    int mode;
    float kr;
    float kb;
    float lum_scale;
    float agree;
} p;

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    if (gx >= p.w || gy >= p.h)
        return;
    int i = gy * p.w + gx;
    vec3 m = vec3(mc_data[i], mc_data[p.w * p.h + i], mc_data[2 * p.w * p.h + i]);
    if (p.mode == 0)
    {
        out_data[i] = sfp(m.r);
        out_data[p.cstep + i] = sfp(m.g);
        out_data[2 * p.cstep + i] = sfp(m.b);
        return;
    }
    vec3 r = vec3(float(rife_data[i]), float(rife_data[p.cstep + i]), float(rife_data[2 * p.cstep + i]));
    vec3 k = vec3(p.kr, 1.f - p.kr - p.kb, p.kb) * p.lum_scale;
    if (p.mode == 1)
    {
        diff_data[i] = abs(dot(k, m) - dot(k, r));
        return;
    }
    float d = diff_data[i] / p.agree;
    float mix_w = 0.5f * exp(-d * d);
    float u = u_data[i];
    vec3 o = (1.f - u) * ((1.f - mix_w) * m + mix_w * r) + u * r;
    out_data[i] = sfp(o.r);
    out_data[p.cstep + i] = sfp(o.g);
    out_data[2 * p.cstep + i] = sfp(o.b);
}
