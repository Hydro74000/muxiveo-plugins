// Restauration (R2) : copie de c canaux (w × h, pas src_cstep) de la région commençant en (x0, y0) vers un tampon
// outw × outh de pas ocstep (outw × outh : NCHW contigu des tampons TensorRT) ; au-delà de w × h, bords droit et bas
// répliqués (tampons TensorRT aux dimensions multiples de 4). Région : recadrage des flux d'analyse avant rapatriement.
#version 450
#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif
layout (binding = 0) readonly buffer src_blob { sfp src_data[]; };
layout (binding = 1) writeonly buffer dst_blob { sfp dst_data[]; };
layout (push_constant) uniform parameter { int w; int h; int c; int cstep; int outw; int outh; int x0; int y0; int ocstep; } p;

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    if (gx >= p.outw || gy >= p.outh || int(gl_GlobalInvocationID.z) >= 1)
        return;
    int si = min(gy + p.y0, p.h - 1) * p.w + min(gx + p.x0, p.w - 1);
    int di = gy * p.outw + gx;
    for (int k = 0; k < p.c; k++)
        dst_data[k * p.ocstep + di] = src_data[k * p.cstep + si];
}
