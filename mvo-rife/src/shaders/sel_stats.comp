// Muxiveo — sélecteur : statistiques par bloc (une invocation par bloc de B px, pixels utiles seulement).
// Luminance du domaine d'apprentissage : y = y_a + y_b · (kr R + kg G + kb B) (codes 10 bits limités / 1023).
// Sorties (9 par bloc) : |y(R05) - y(R1)|, |y(MC) - y(R1)|, |y(Rbwd) - y(R1)|, |y(NV) - y(R1)|, texture
// (|dx| + |dy| moyen des deux sources), |y(A) - y(B)|, y(R1), incohérence NVOF / 64, amplitude NVOF / 64.

#version 450

#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif

layout (binding = 0) readonly buffer r1_blob { sfp r1[]; };
layout (binding = 1) readonly buffer r05_blob { sfp r05[]; };
layout (binding = 2) readonly buffer mc_blob { sfp mc[]; };
layout (binding = 3) readonly buffer rb_blob { sfp rb[]; };
layout (binding = 4) readonly buffer nv_blob { sfp nv[]; };
layout (binding = 5) readonly buffer a_blob { sfp a_data[]; };
layout (binding = 6) readonly buffer b_blob { sfp b_data[]; };
layout (binding = 7) readonly buffer map_blob { float maps[]; };      // nvinc, nvmag (w × h), si NV
layout (binding = 8) writeonly buffer stat_blob { float stats[]; };   // (nby, nbx, 9)
layout (binding = 9) readonly buffer source_stat_blob { float source_stats[]; };

layout (push_constant) uniform parameter
{
    int w;
    int h;
    int pw;          // largeur paddée des images RGB
    int nbx;
    int nby;
    int block;
    int cands;       // bits : 2 R05, 8 Rbwd, 16 NV (R1 et MC toujours présents)
    int cs_r1;       // pas des plans de chaque candidat
    int cs_r05;
    int cs_mc;
    int cs_rb;
    int cs_nv;
    int cs_src;
    float kr;
    float kb;
    float ya;
    float yb;
    int reuse_sources; // texture, différence A/B et cartes NVOF inchangées pour une même paire
} p;

float lum(float r, float g, float b)
{
    return p.ya + p.yb * (p.kr * r + (1.f - p.kr - p.kb) * g + p.kb * b);
}

#define LUM(buf, cs, i) lum(float(buf[i]), float(buf[(cs) + (i)]), float(buf[2 * (cs) + (i)]))

void main()
{
    int bx = int(gl_GlobalInvocationID.x);
    int by = int(gl_GlobalInvocationID.y);
    if (bx >= p.nbx || by >= p.nby)
        return;
    int x0 = bx * p.block;
    int y0 = by * p.block;
    int x1 = min(x0 + p.block, p.w);
    int y1 = min(y0 + p.block, p.h);
    bool has_r05 = (p.cands & 2) != 0;
    bool has_rb = (p.cands & 8) != 0;
    bool has_nv = (p.cands & 16) != 0;
    float s[9];
    for (int k = 0; k < 9; k++)
        s[k] = 0.f;
    for (int y = y0; y < y1; y++)
    {
        for (int x = x0; x < x1; x++)
        {
            int i = y * p.pw + x;
            float yr = LUM(r1, p.cs_r1, i);
            if (has_r05)
                s[0] += abs(LUM(r05, p.cs_r05, i) - yr);
            s[1] += abs(LUM(mc, p.cs_mc, i) - yr);
            if (has_rb)
                s[2] += abs(LUM(rb, p.cs_rb, i) - yr);
            if (has_nv)
                s[3] += abs(LUM(nv, p.cs_nv, i) - yr);
            if (p.reuse_sources == 0)
            {
                float ya = LUM(a_data, p.cs_src, i);
                float yb = LUM(b_data, p.cs_src, i);
                float ga = 0.f;
                float gb = 0.f;
                if (x + 1 < p.w)
                {
                    ga += abs(LUM(a_data, p.cs_src, i + 1) - ya);
                    gb += abs(LUM(b_data, p.cs_src, i + 1) - yb);
                }
                if (y + 1 < p.h)
                {
                    ga += abs(LUM(a_data, p.cs_src, i + p.pw) - ya);
                    gb += abs(LUM(b_data, p.cs_src, i + p.pw) - yb);
                }
                s[4] += (ga + gb) / 2.f;
                s[5] += abs(ya - yb);
                if (has_nv)
                {
                    int j = y * p.w + x;
                    s[7] += maps[j] / 64.f;
                    s[8] += maps[p.w * p.h + j] / 64.f;
                }
            }
            s[6] += yr;
        }
    }
    float n = float(max((x1 - x0) * (y1 - y0), 1));
    int o = (by * p.nbx + bx) * 9;
    for (int k = 0; k < 9; k++)
        stats[o + k] = p.reuse_sources != 0 && (k == 4 || k == 5 || k == 7 || k == 8)
                       ? source_stats[o + k] : s[k] / n;
}
